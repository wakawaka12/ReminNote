<Window x:Class="ReminNote.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReminNote Widget Mock"
        Width="500"
        Height="390"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        SizeChanged="OnWindowSizeChanged">
    <Border Style="{StaticResource WidgetWindowSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Style="{StaticResource WidgetHeaderSurfaceStyle}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ReminNote"
                                   Style="{StaticResource WidgetBrandTextStyle}" />
                        <TextBlock Text="&#x8F7B;&#x91CF; Widget &#x00B7; P0 Mock"
                                   Style="{StaticResource WidgetEyebrowTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Margin="12,0,8,0"
                            Style="{StaticResource WidgetStateChipStyle}">
                        <Button Command="{Binding ToggleInteractionCommand}"
                                Style="{StaticResource WidgetStateButtonStyle}"
                                ToolTip="&#x5207;&#x6362; Widget Mock &#x4EA4;&#x4E92;&#x72B6;&#x6001;">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InteractionStateIcon}"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="{Binding InteractionStateLabel}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Button Grid.Column="3"
                            Click="OnCloseClick"
                            Content="&#x00D7;"
                            Style="{StaticResource WidgetCloseButtonStyle}"
                            ToolTip="&#x5173;&#x95ED; Widget Mock" />
                </Grid>
            </Border>
            <Grid Grid.Row="1"
                  Margin="{StaticResource WidgetContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ActivePageTitle}"
                                   Style="{StaticResource WidgetPageTitleTextStyle}" />
                        <TextBlock Text="{Binding ActivePageSubtitle}"
                                   Style="{StaticResource WidgetPageSubtitleTextStyle}" />
                        <TextBlock Text="EXPANDED LAYOUT &#x00B7; FULL QUEUE"
                                   Style="{StaticResource WidgetEyebrowTextStyle}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="TODAY"
                                Command="{Binding ShowTodayCommand}"
                                Style="{StaticResource WidgetTodayTabButtonStyle}" />
                        <Button Content="ANIME"
                                Command="{Binding ShowAnimeCommand}"
                                Style="{StaticResource WidgetAnimeTabButtonStyle}"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid x:Name="TodayPage"
                          Visibility="{Binding IsTodayActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource WidgetPrimaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="3" />
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0">
                                    <TextBlock Text="PRIMARY &#x00B7; NEXT UP"
                                               Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                                    <TextBlock Text="&#x6574;&#x7406;&#x684C;&#x9762;&#x8D44;&#x6599;"
                                               Style="{StaticResource WidgetPrimaryTitleTextStyle}" />
                                    <TextBlock Text="TODAY &#x00B7; ANYTIME &#x00B7; &#x751F;&#x6D3B;"
                                               Style="{StaticResource WidgetMetaTextStyle}"
                                               Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding TaskFeedback}"
                                               Style="{StaticResource WidgetFeedbackTextStyle}"
                                               Visibility="{Binding HasTaskFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TaskStatusLabel}"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetStatusTextStyle}" />
                                    <TextBlock Text="&#x73B0;&#x5728;"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetTimeTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="UPCOMING"
                                       Style="{StaticResource WidgetSectionLabelTextStyle}" />
                            <ItemsControl ItemsSource="{Binding TodayUpcomingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WidgetQueueItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}"
                                                           Style="{StaticResource WidgetQueueTimeTextStyle}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Meta}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Marker}"
                                                           Style="{StaticResource WidgetQueueMarkerTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Grid.Row="2"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SUMMARY"
                                           Style="{StaticResource WidgetSectionLabelTextStyle}" />
                                <TextBlock Text="2 &#x4E2A;&#x8BA1;&#x5212; &#x00B7; 1 &#x5F85;&#x786E;&#x8BA4;"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="2 &#x8BA1;&#x5212;"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="&#x5B8C;&#x6210;"
                                    Command="{Binding CompleteTaskCommand}"
                                    Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="&#x5EF6;&#x540E;"
                                    Command="{Binding SnoozeTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Grid.Column="3"
                                    Content="&#x6539;&#x671F;"
                                    Command="{Binding RescheduleTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="AnimePage"
                          Visibility="{Binding IsAnimeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource WidgetPrimaryAnimeCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WidgetCoverPlaceholderStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="EP"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource WidgetCoverLabelTextStyle}" />
                                        <TextBlock Text="01"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource WidgetCoverNumberTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0">
                                    <TextBlock Text="PRIMARY &#x00B7; NEXT AIRING"
                                               Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                                    <TextBlock Text="&#x846C;&#x9001;&#x7684;&#x8299;&#x8389;&#x83B2;"
                                               Style="{StaticResource WidgetPrimaryTitleTextStyle}" />
                                    <TextBlock Text="&#x7B2C; 01 &#x96C6; &#x00B7; &#x8FFD;&#x756A;&#x4E2D;"
                                               Style="{StaticResource WidgetMetaTextStyle}"
                                               Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding AnimeFeedback}"
                                               Style="{StaticResource WidgetFeedbackTextStyle}"
                                               Visibility="{Binding HasAnimeFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="&#x4ECA;&#x665A;"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetStatusTextStyle}" />
                                    <TextBlock Text="23:00"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetTimeTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="UPCOMING"
                                       Style="{StaticResource WidgetSectionLabelTextStyle}" />
                            <ItemsControl ItemsSource="{Binding AnimeUpcomingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WidgetQueueItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}"
                                                           Style="{StaticResource WidgetQueueTimeTextStyle}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Meta}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Marker}"
                                                           Style="{StaticResource WidgetQueueMarkerTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Grid.Row="2"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SUMMARY"
                                           Style="{StaticResource WidgetSectionLabelTextStyle}" />
                                <TextBlock Text="6 &#x8FFD;&#x756A; &#x00B7; 3 WATCH LATER"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="6 &#x8FFD;&#x756A;"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="WATCHED"
                                    Command="{Binding WatchAnimeCommand}"
                                    Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="&#x7A0D;&#x540E;&#x770B;"
                                    Command="{Binding WatchLaterCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Grid.Column="3"
                                    Content="&#x6392;&#x4EFB;&#x52A1;"
                                    Command="{Binding ScheduleAnimeTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="2"
                    Style="{StaticResource WidgetFooterSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LOCAL MOCK &#x00B7; NO DATA CONNECTION"
                               VerticalAlignment="Center"
                               Style="{StaticResource WidgetFooterTextStyle}"
                               Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Grid.Column="1"
                            Content="QUICK ADD"
                            Command="{Binding ToggleQuickAddCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}" />
                    <Button Grid.Column="2"
                            Content="REMINDERS &#x00B7; 2"
                            Command="{Binding OpenReminderDrawerCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}"
                            Margin="4,0,0,0" />
                    <Button Grid.Column="3"
                            Content="&#x6A21;&#x62DF;&#x63D0;&#x9192;"
                            Command="{Binding SimulateAlertCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}"
                            Margin="4,0,0,0"
                            Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <Border Grid.RowSpan="3"
                    Panel.ZIndex="10"
                    Style="{StaticResource WidgetAlertOverlayStyle}"
                    Visibility="{Binding IsAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="!"
                                   Style="{StaticResource WidgetAlertIconTextStyle}" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="HIGH PRIORITY"
                                       Style="{StaticResource WidgetAlertEyebrowTextStyle}" />
                            <TextBlock Text="&#x9700;&#x8981;&#x4F60;&#x786E;&#x8BA4;&#x7684;&#x63D0;&#x9192;"
                                       Style="{StaticResource WidgetAlertTitleTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                Margin="0,18,0,18">
                        <TextBlock Text="&#x4F60;&#x7684;&#x63D0;&#x9192;&#x4ECD;&#x672A;&#x5904;&#x7406;&#x3002;&#x8FD9;&#x4E2A; Alert &#x4EC5;&#x7528;&#x4E8E;&#x9A8C;&#x8BC1; Widget &#x7684;&#x6CE8;&#x610F;&#x529B;&#x72B6;&#x6001;&#xFF0C;&#x4E0D;&#x4F1A;&#x5207;&#x6362;&#x5F53;&#x524D;&#x9875;&#x9762;&#x3002;"
                                   Style="{StaticResource WidgetAlertBodyTextStyle}" />
                        <TextBlock Style="{StaticResource WidgetAlertContextTextStyle}">
                            <Run Text="&#x5F53;&#x524D;&#x9875;&#x9762;&#xFF1A;" />
                            <Run Text="{Binding ActivePageTitle}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="&#x6253;&#x5F00;&#x63D0;&#x9192;&#x62BD;&#x5C49;"
                                Command="{Binding OpenReminderDrawerCommand}"
                                Style="{StaticResource WidgetSecondaryActionButtonStyle}" />
                        <Button Content="&#x5DF2;&#x5904;&#x7406;"
                                Command="{Binding DismissAlertCommand}"
                                Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.RowSpan="3"
                    Panel.ZIndex="20"
                    Style="{StaticResource WidgetQuickAddOverlayStyle}"
                    Visibility="{Binding IsQuickAddOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="QUICK ADD &#x00B7; MOCK"
                               Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                    <TextBlock Text="&#x8F93;&#x5165;&#x4E00;&#x6761;&#x8F7B;&#x91CF;&#x8BA1;&#x5212;&#xFF0C;&#x7ED3;&#x679C;&#x53EA;&#x4FDD;&#x7559;&#x5728;&#x5F53;&#x524D;&#x7A97;&#x53E3;&#x5185;&#x3002;"
                               Margin="0,3,0,10"
                               Style="{StaticResource WidgetAlertBodyTextStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WidgetQuickAddTextBoxStyle}"
                                 ToolTip="&#x793A;&#x4F8B;&#xFF1A;&#x660E;&#x5929; 18:00 &#x4E70;&#x4E1C;&#x897F; #&#x751F;&#x6D3B;" />
                        <Button Grid.Column="1"
                                Content="&#x6DFB;&#x52A0;"
                                Command="{Binding SubmitQuickAddCommand}"
                                Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding QuickAddFeedback}"
                               Style="{StaticResource WidgetFeedbackTextStyle}"
                               Visibility="{Binding HasQuickAddFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
            <Border Grid.RowSpan="3"
                    Panel.ZIndex="30"
                    Style="{StaticResource WidgetDrawerOverlayStyle}"
                    Visibility="{Binding IsReminderDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="&#x00D7;"
                                Command="{Binding CloseReminderDrawerCommand}"
                                Style="{StaticResource WidgetCloseButtonStyle}" />
                        <StackPanel>
                            <TextBlock Text="REMINDERS &#x00B7; 2"
                                       Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                            <TextBlock Text="&#x6700;&#x8FD1;&#x672A;&#x89E3;&#x51B3;&#x7684;&#x63D0;&#x9192;"
                                       Style="{StaticResource WidgetAlertTitleTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1"
                                Margin="0,20,0,20">
                        <Border Style="{StaticResource WidgetReminderItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="&#x6574;&#x7406;&#x684C;&#x9762;&#x8D44;&#x6599;"
                                               Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                    <TextBlock Text="TASK_CUSTOM &#x00B7; 10 &#x5206;&#x949F;&#x524D;"
                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="&#x672A;&#x8BFB;"
                                           Style="{StaticResource WidgetReminderStatusTextStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource WidgetReminderItemStyle}"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="&#x846C;&#x9001;&#x7684;&#x8299;&#x8389;&#x83B2; &#x00B7; &#x7B2C; 01 &#x96C6;"
                                               Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                    <TextBlock Text="ANIME_AIRING &#x00B7; &#x4ECA;&#x665A; 23:00"
                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="&#x5F85;&#x5904;&#x7406;"
                                           Style="{StaticResource WidgetReminderStatusTextStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2"
                            Content="&#x6807;&#x8BB0;&#x5F53;&#x524D;&#x63D0;&#x9192;&#x5DF2;&#x8BFB; (Mock)"
                            Command="{Binding MarkReminderReadCommand}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource WidgetSecondaryActionButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
