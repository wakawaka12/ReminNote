<Window x:Class="ReminNote.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ReminNote.Windows.Resources.Localization"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowTitle}"
        Width="500"
        Height="390"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SizeChanged="OnWindowSizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="20"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowSurface"
            Style="{StaticResource WidgetWindowSurfaceStyle}"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Style="{StaticResource WidgetHeaderSurfaceStyle}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                    AutomationProperties.Name="{x:Static local:UiText.WidgetHeaderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static local:UiText.ShellBrandName}"
                                   Style="{StaticResource WidgetBrandTextStyle}" />
                        <TextBlock Text="{Binding WidgetSubtitle}"
                                   Style="{StaticResource WidgetEyebrowTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Margin="12,0,8,0"
                            Style="{StaticResource WidgetStateChipStyle}">
                                <Button Command="{Binding ToggleInteractionCommand}"
                                Style="{StaticResource WidgetStateButtonStyle}"
                                ToolTip="{x:Static local:UiText.WidgetStateToolTip}"
                                AutomationProperties.Name="{Binding InteractionStateLabel}"
                                AutomationProperties.HelpText="{x:Static local:UiText.WidgetStateToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InteractionStateIcon}"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="{Binding InteractionStateLabel}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Button Grid.Column="3"
                            Click="OnCloseClick"
                            Content="×"
                            Style="{StaticResource WidgetCloseButtonStyle}"
                            ToolTip="{x:Static local:UiText.WidgetClose}"
                            AutomationProperties.Name="{x:Static local:UiText.WidgetClose}" />
                </Grid>
            </Border>
            <Grid Grid.Row="1"
                  Margin="{StaticResource WidgetContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ActivePageTitle, Mode=OneWay}"
                                   Style="{StaticResource WidgetPageTitleTextStyle}" />
                        <TextBlock Text="{Binding ActivePageSubtitle, Mode=OneWay}"
                                   Style="{StaticResource WidgetPageSubtitleTextStyle}" />
                        <TextBlock Text="{x:Static local:UiText.WidgetExpandedLayout}"
                                   Style="{StaticResource WidgetEyebrowTextStyle}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="{x:Static local:UiText.WidgetTodayTab}"
                                Command="{Binding ShowTodayCommand}"
                                Style="{StaticResource WidgetTodayTabButtonStyle}"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetTodayTab}" />
                        <Button Content="{x:Static local:UiText.WidgetAnimeTab}"
                                Command="{Binding ShowAnimeCommand}"
                                Style="{StaticResource WidgetAnimeTabButtonStyle}"
                                Margin="6,0,0,0"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetAnimeTab}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1"
                              x:Name="ContentScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              PanningMode="VerticalOnly"
                              Focusable="False"
                              KeyboardNavigation.IsTabStop="False">
                    <Grid>
                    <Grid x:Name="TodayPage"
                          Visibility="{Binding IsTodayActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource WidgetPrimaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="3" />
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0">
                                    <TextBlock Text="当前选中 Task"
                                               Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                                    <TextBlock Text="{Binding SelectedTaskTitle}"
                                               Style="{StaticResource WidgetPrimaryTitleTextStyle}" />
                                    <TextBlock Text="{Binding SelectedTaskMeta}"
                                               Style="{StaticResource WidgetMetaTextStyle}"
                                               Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding TaskFeedback}"
                                               Style="{StaticResource WidgetFeedbackTextStyle}"
                                               Visibility="{Binding HasTaskFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TaskStatusLabel}"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetStatusTextStyle}" />
                                    <TextBlock Text="{Binding SelectedTaskTimeLabel}"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetTimeTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="操作当前选中 Task"
                                           Style="{StaticResource WidgetSectionLabelTextStyle}" />
                                <TextBlock Text="{Binding TodaySummaryFull}"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding TodaySummaryCompact}"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Static local:UiText.WidgetComplete}"
                                    Command="{Binding CompleteTaskCommand}"
                                    Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetComplete}" />
                            <Button Grid.Column="2"
                                    Content="{x:Static local:UiText.WidgetSnooze}"
                                    Command="{Binding SnoozeTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetSnooze}" />
                            <Button Grid.Column="3"
                                    Content="{x:Static local:UiText.WidgetReschedule}"
                                    Command="{Binding RescheduleTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetReschedule}" />
                        </Grid>
                        <StackPanel Grid.Row="2"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsResultActionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ResultActionHint}"
                                       Style="{StaticResource WidgetSectionLabelTextStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,5,0,0">
                                <Button Content="记录 PARTIAL"
                                        Command="{Binding RecordPartialTaskCommand}"
                                        Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                        AutomationProperties.Name="记录 PARTIAL 结果" />
                                <Button Content="记录 MISSED"
                                        Command="{Binding RecordMissedTaskCommand}"
                                        Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="记录 MISSED 结果" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3"
                                    Margin="0,10,0,0">
                            <TextBlock Text="选择任务"
                                       Style="{StaticResource WidgetSectionLabelTextStyle}" />
                            <TextBlock Text="点击任意任务后，再使用上方操作按钮"
                                       Style="{StaticResource WidgetQueueMetaTextStyle}" />
                            <ItemsControl ItemsSource="{Binding TodayUpcomingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}"
                                                Style="{StaticResource WidgetQueueItemButtonStyle}"
                                                AutomationProperties.Name="{Binding Title}"
                                                AutomationProperties.HelpText="点击选中此 Task">
                                            <Border Style="{StaticResource WidgetQueueItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}"
                                                               Style="{StaticResource WidgetQueueTimeTextStyle}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Marker}"
                                                               Style="{StaticResource WidgetQueueMarkerTextStyle}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AnimePage"
                          Visibility="{Binding IsAnimeActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource WidgetPrimaryAnimeCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WidgetCoverPlaceholderStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="EP"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource WidgetCoverLabelTextStyle}" />
                                        <TextBlock Text="01"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource WidgetCoverNumberTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0">
                                    <TextBlock Text="{x:Static local:UiText.WidgetPrimaryNextAiring}"
                                               Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                                    <TextBlock Text="&#x846C;&#x9001;&#x7684;&#x8299;&#x8389;&#x83B2;"
                                               Style="{StaticResource WidgetPrimaryTitleTextStyle}" />
                                    <TextBlock Text="第 01 集 · 追番中"
                                               Style="{StaticResource WidgetMetaTextStyle}"
                                               Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding AnimeFeedback}"
                                               Style="{StaticResource WidgetFeedbackTextStyle}"
                                               Visibility="{Binding HasAnimeFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Static local:UiText.WidgetTonight}"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetStatusTextStyle}" />
                                    <TextBlock Text="23:00"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource WidgetTimeTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Static local:UiText.WidgetUpcoming}"
                                       Style="{StaticResource WidgetSectionLabelTextStyle}" />
                            <ItemsControl ItemsSource="{Binding AnimeUpcomingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WidgetQueueItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}"
                                                           Style="{StaticResource WidgetQueueTimeTextStyle}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Meta}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Marker}"
                                                           Style="{StaticResource WidgetQueueMarkerTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Grid.Row="2"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:UiText.WidgetSummary}"
                                           Style="{StaticResource WidgetSectionLabelTextStyle}" />
                                <TextBlock Text="6 追番 · 3 WATCH LATER"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="6 追番"
                                           Style="{StaticResource WidgetSummaryTextStyle}"
                                           Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Static local:UiText.WidgetWatched}"
                                    Command="{Binding WatchAnimeCommand}"
                                    Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetWatched}" />
                            <Button Grid.Column="2"
                                    Content="{x:Static local:UiText.WidgetWatchLater}"
                                    Command="{Binding WatchLaterCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetWatchLater}" />
                            <Button Grid.Column="3"
                                    Content="{x:Static local:UiText.WidgetScheduleTask}"
                                    Command="{Binding ScheduleAnimeTaskCommand}"
                                    Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{x:Static local:UiText.WidgetScheduleTask}" />
                        </Grid>
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2"
                    Panel.ZIndex="40"
                    Style="{StaticResource WidgetFooterSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceLabel}"
                                   Style="{StaticResource WidgetFooterTextStyle}"
                                   Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ReminderFeedback}"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource WidgetFeedbackTextStyle}"
                                   Visibility="{Binding HasReminderFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding QuickAddTriggerLabel}"
                            Command="{Binding ToggleQuickAddCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}"
                            AutomationProperties.Name="{Binding QuickAddTriggerLabel}"
                            ToolTip="{Binding QuickAddTriggerLabel}" />
                    <Button Grid.Column="2"
                            Content="{Binding ReminderTriggerLabel}"
                            Command="{Binding OpenReminderDrawerCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{Binding ReminderTriggerLabel}"
                            ToolTip="{Binding ReminderTriggerLabel}" />
                    <Button Grid.Column="3"
                            Content="{Binding AlertTriggerLabel}"
                            Command="{Binding SimulateAlertCommand}"
                            Style="{StaticResource WidgetFooterButtonStyle}"
                            Margin="4,0,0,0"
                            Visibility="{Binding IsNotCompact, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{Binding AlertTriggerLabel}"
                            ToolTip="{Binding AlertTriggerLabel}" />
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Panel.ZIndex="10"
                    Style="{StaticResource WidgetAlertOverlayStyle}"
                    Visibility="{Binding IsAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Command="{Binding DismissAlertCommand}"
                                Style="{StaticResource WidgetCloseButtonStyle}"
                                ToolTip="{x:Static local:UiText.WidgetDismissAlert}"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetDismissAlert}"
                                AutomationProperties.HelpText="{x:Static local:UiText.WidgetDismissAlert}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!"
                                       Style="{StaticResource WidgetAlertIconTextStyle}" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{x:Static local:UiText.WidgetHighPriority}"
                                           Style="{StaticResource WidgetAlertEyebrowTextStyle}" />
                                <TextBlock Text="{x:Static local:UiText.WidgetAlertTitle}"
                                           Style="{StaticResource WidgetAlertTitleTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                Margin="0,18,0,18">
                        <TextBlock Text="{x:Static local:UiText.WidgetAlertBody}"
                                   Style="{StaticResource WidgetAlertBodyTextStyle}" />
                        <TextBlock Style="{StaticResource WidgetAlertContextTextStyle}">
                            <Run Text="{x:Static local:UiText.WidgetCurrentPage}" />
                            <Run Text="{Binding ActivePageTitle, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="{x:Static local:UiText.WidgetOpenReminderDrawer}"
                                Command="{Binding OpenReminderDrawerCommand}"
                                Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetOpenReminderDrawer}" />
                        <Button Content="{x:Static local:UiText.WidgetDismissAlert}"
                                Command="{Binding DismissAlertCommand}"
                                Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetDismissAlert}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Panel.ZIndex="20"
                    Style="{StaticResource WidgetQuickAddOverlayStyle}"
                    Visibility="{Binding IsQuickAddOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Command="{Binding CloseQuickAddCommand}"
                                Style="{StaticResource WidgetCloseButtonStyle}"
                                ToolTip="{x:Static local:UiText.WidgetClose}"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetClose}"
                                AutomationProperties.HelpText="{x:Static local:UiText.WidgetClose}" />
                        <StackPanel>
                            <TextBlock Text="{Binding QuickAddHeading}"
                                       Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                            <TextBlock Text="{Binding QuickAddDescription}"
                                       Margin="0,3,0,10"
                                       Style="{StaticResource WidgetAlertBodyTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WidgetQuickAddTextBoxStyle}"
                                 ToolTip="{Binding QuickAddToolTip}"
                                 AutomationProperties.Name="{Binding QuickAddToolTip}"
                                 AutomationProperties.HelpText="{Binding QuickAddDescription}" />
                        <Button Grid.Column="1"
                                Content="{x:Static local:UiText.WidgetAdd}"
                                Command="{Binding SubmitQuickAddCommand}"
                                Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetAdd}" />
                    </Grid>
                    <TextBlock Text="{Binding QuickAddFeedback}"
                               Style="{StaticResource WidgetFeedbackTextStyle}"
                               Visibility="{Binding HasQuickAddFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Panel.ZIndex="30"
                    Style="{StaticResource WidgetDrawerOverlayStyle}"
                    Visibility="{Binding IsReminderDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="&#x00D7;"
                                Command="{Binding CloseReminderDrawerCommand}"
                                Style="{StaticResource WidgetCloseButtonStyle}"
                                ToolTip="{x:Static local:UiText.WidgetClose}"
                                AutomationProperties.Name="{x:Static local:UiText.WidgetClose}" />
                        <StackPanel>
                            <TextBlock Text="{Binding ReminderDrawerHeading}"
                                       Style="{StaticResource WidgetCardEyebrowTextStyle}" />
                            <TextBlock Text="{Binding ReminderDrawerTitle}"
                                       Style="{StaticResource WidgetAlertTitleTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,16"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ReminderSnapshotStatusLabel}"
                                           Style="{StaticResource WidgetQueueMetaTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ReminderItems}"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding HasReminderItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource WidgetReminderItemStyle}"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding LifecycleLabel}"
                                                                   Style="{StaticResource WidgetReminderStatusTextStyle}" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding PurposeLabel}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding PriorityLabel}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                    <TextBlock Text="{Binding TriggeredAtLabel}"
                                                               Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="{x:Static local:UiText.ReminderDone}"
                                                                Command="{Binding DoneCommand}"
                                                                Style="{StaticResource WidgetPrimaryActionButtonStyle}"
                                                                Margin="0,0,5,0" />
                                                        <Button Content="{x:Static local:UiText.ReminderSnooze}"
                                                                Command="{Binding SnoozeCommand}"
                                                                Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                                                Margin="0,0,5,0" />
                                                        <Button Content="{x:Static local:UiText.ReminderSkip}"
                                                                Command="{Binding SkipCommand}"
                                                                Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                                                Margin="0,0,5,0" />
                                                        <Button Content="{x:Static local:UiText.ReminderIgnore}"
                                                                Command="{Binding IgnoreCommand}"
                                                                Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                                                                Margin="0,0,5,0" />
                                                        <Button Content="{x:Static local:UiText.ReminderMarkRead}"
                                                                Command="{Binding MarkReadCommand}"
                                                                Style="{StaticResource WidgetSecondaryActionButtonStyle}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding ActionFeedback}"
                                                               Style="{StaticResource WidgetFeedbackTextStyle}"
                                                               Margin="0,5,0,0"
                                                               Visibility="{Binding HasActionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Static local:UiText.ReminderSnapshotEmpty}"
