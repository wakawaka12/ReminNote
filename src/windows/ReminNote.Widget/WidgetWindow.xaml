                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding HasNoReminderItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource WidgetReminderItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="&#x6574;&#x7406;&#x684C;&#x9762;&#x8D44;&#x6599;"
                                                       Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                            <TextBlock Text="{x:Static local:UiText.WidgetTaskReminderMeta}"
                                                       Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static local:UiText.WidgetUnread}"
                                                   Style="{StaticResource WidgetReminderStatusTextStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource WidgetReminderItemStyle}"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static local:UiText.WidgetAnimeReminderTitle}"
                                                       Style="{StaticResource WidgetQueueTitleTextStyle}" />
                                            <TextBlock Text="{x:Static local:UiText.WidgetAnimeReminderMeta}"
                                                       Style="{StaticResource WidgetQueueMetaTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static local:UiText.WidgetPending}"
                                                   Style="{StaticResource WidgetReminderStatusTextStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Button Grid.Row="2"
                            Content="{x:Static local:UiText.WidgetMarkReminderRead}"
                            Command="{Binding MarkReminderReadCommand}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource WidgetSecondaryActionButtonStyle}"
                            Visibility="{Binding IsMock, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Static local:UiText.WidgetMarkReminderRead}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
