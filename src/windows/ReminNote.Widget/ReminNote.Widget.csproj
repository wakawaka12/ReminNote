<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ReminNote.Widget</RootNamespace>
    <AssemblyName>ReminNote.Widget</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\ReminNote.Agent\ReminNote.Agent.csproj" />
    <ProjectReference Include="..\ReminNote.Core\ReminNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ReminNote.Windows\Features\Reminders\ReminderItemViewModel.cs"
             Link="Features\Reminders\ReminderItemViewModel.cs" />
    <Page Include="..\ReminNote.Windows\Resources\DesignSystem\Colors.xaml"
          Link="Resources\DesignSystem\Colors.xaml" />
    <Page Include="..\ReminNote.Windows\Resources\DesignSystem\Spacing.xaml"
          Link="Resources\DesignSystem\Spacing.xaml" />
    <Page Include="..\ReminNote.Windows\Resources\DesignSystem\Typography.xaml"
          Link="Resources\DesignSystem\Typography.xaml" />
    <Page Include="..\ReminNote.Windows\Resources\DesignSystem\Controls.xaml"
          Link="Resources\DesignSystem\Controls.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ReminNote.Windows\Resources\Localization\UiText.cs"
             Link="Resources\Localization\UiText.cs" />
    <EmbeddedResource Include="..\ReminNote.Windows\Resources\Localization\UiText.resx"
                      Link="Resources\Localization\UiText.resx">
      <LogicalName>ReminNote.Windows.Resources.Localization.UiText.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
