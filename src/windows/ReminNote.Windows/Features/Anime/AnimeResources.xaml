<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:anime="clr-namespace:ReminNote.Windows.Features.Anime">
    <DataTemplate DataType="{x:Type anime:AnimePageViewModel}">
        <Grid Margin="{StaticResource PageContentMargin}">
            <StackPanel MaxWidth="720">
                <TextBlock Text="动画"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource PageDescriptionTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="ANIME Shell 占位"
                                   Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="动画数据、追番状态和网络 Provider 会在后续 Slice 接入。"
                                   Style="{StaticResource CardBodyTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
