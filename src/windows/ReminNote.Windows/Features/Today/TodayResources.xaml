<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:today="clr-namespace:ReminNote.Windows.Features.Today"
                    xmlns:local="clr-namespace:ReminNote.Windows.Resources.Localization">
    <BooleanToVisibilityConverter x:Key="TodayBooleanToVisibilityConverter" />

    <Style x:Key="TodayEyebrowTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="TodayDateTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin"
                Value="0,8,0,0" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <Style x:Key="TodayIntroTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin"
                Value="0,8,0,0" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentSecondaryBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="TodayMetricValueTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize"
                Value="22" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style x:Key="TodayMetricLabelTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin"
                Value="0,4,0,0" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <Style x:Key="TodayTaskTitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TodayTaskMetaTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin"
                Value="0,7,0,0" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <Style x:Key="TodayTaskTimeTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="TextAlignment"
                Value="Right" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="TodayGroupTitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style x:Key="TodayGroupSubtitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Margin"
                Value="0,3,0,0" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <Style x:Key="TodayChipBorderStyle"
           TargetType="{x:Type Border}">
        <Setter Property="Padding"
                Value="8,4" />
        <Setter Property="Background"
                Value="{DynamicResource ShellBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="8" />
    </Style>

    <Style x:Key="TodayPanelStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding"
                Value="20" />
        <Setter Property="Margin"
                Value="0,0,0,16" />
    </Style>

    <Style x:Key="TodayPrimaryPanelStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding"
                Value="22" />
        <Setter Property="Margin"
                Value="0,0,16,16" />
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="TodayGroupPanelStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding"
                Value="16" />
        <Setter Property="Margin"
                Value="0,0,0,12" />
    </Style>

    <Style x:Key="TodayTaskCardStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding"
                Value="11" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness"
                        Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCompleted}"
                         Value="True">
                <Setter Property="Opacity"
                        Value="0.72" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodayButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource SidebarPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="14,9" />
        <Setter Property="FontFamily"
                Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Focusable"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NavigationCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccessibleFocusBrush}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TodaySecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ShellBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodayHeroLightButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource CardBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource ShellBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodayHeroOutlineButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayButtonStyle}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource SidebarPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource SidebarPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodayTransparentButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Focusable"
                Value="True" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="TransparentButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NavigationCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="TransparentButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccessibleFocusBrush}" />
                            <Setter TargetName="TransparentButtonBorder"
                                    Property="BorderThickness"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="TransparentButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource ShellBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TodayTaskSelectButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayTransparentButtonStyle}">
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="8,0" />
    </Style>

    <Style x:Key="TodayGroupHeaderButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayTransparentButtonStyle}">
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,0,12" />
    </Style>

    <Style x:Key="TodayIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodaySecondaryButtonStyle}">
        <Setter Property="Width"
                Value="30" />
        <Setter Property="Height"
                Value="30" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="FontSize"
                Value="16" />
    </Style>

    <Style x:Key="TodayCheckButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource TodayIconButtonStyle}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="TodayTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight"
                Value="40" />
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="FontFamily"
                Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource ContentPrimaryBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource AccessibleFocusBrush}" />
                <Setter Property="BorderThickness"
                        Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TodayTaskItemTemplate">
        <Border Style="{StaticResource TodayTaskCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="⋮⋮"
                           FontSize="16"
                           Foreground="{DynamicResource ContentSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Cursor="SizeAll"
                           ToolTip="拖动以调整同一日期、同一分组内的顺序"
                           AutomationProperties.Name="拖动手柄"
                           AutomationProperties.HelpText="拖动任务卡调整同一日期、同一分组内的顺序" />

                <Button Grid.Column="1"
                        Style="{StaticResource TodayCheckButtonStyle}"
                        Content="{Binding CompletionGlyph}"
                        Command="{Binding ToggleCompletionCommand}"
                        IsEnabled="{Binding IsCompletionActionEnabled}"
                        ToolTip="{Binding CompletionActionLabel}"
                        AutomationProperties.Name="{Binding CompletionActionLabel}"
                        AutomationProperties.HelpText="{Binding AutomationHelpText}" />

                <Button Grid.Column="2"
                        Style="{StaticResource TodayTaskSelectButtonStyle}"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding AutomationName}"
                        AutomationProperties.HelpText="{Binding AutomationHelpText}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource TodayTaskTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource TodayChipBorderStyle}"
                                    Margin="0,7,6,0">
                                <TextBlock Text="{Binding TimeShapeLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource ContentSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource TodayChipBorderStyle}"
                                    Margin="0,7,6,0">
                                <TextBlock Text="{Binding StatusLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Style="{StaticResource TodayChipBorderStyle}"
                                    Margin="0,7,0,0"
                                    Visibility="{Binding IsNeedsReviewVisible, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                                <TextBlock Text="{x:Static local:UiText.TodayNeedsReviewLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CategoryLabel}"
                                   Style="{StaticResource TodayTaskMetaTextStyle}" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="3"
                           Text="{Binding TimeLabel}"
                           Style="{StaticResource TodayTaskTimeTextStyle}"
                           MaxWidth="118"
                           Margin="6,0,8,0" />

                <Button Grid.Column="4"
                        Style="{StaticResource TodayIconButtonStyle}"
                        Content="{Binding PinGlyph}"
                        Command="{Binding TogglePinCommand}"
                        ToolTip="{Binding PinActionLabel}"
                        AutomationProperties.Name="{Binding PinActionLabel}"
                        AutomationProperties.HelpText="{Binding AutomationHelpText}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TodayTaskGroupTemplate">
        <Border Style="{StaticResource TodayGroupPanelStyle}"
                Visibility="{Binding HasItems, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
            <StackPanel>
                <Button Style="{StaticResource TodayGroupHeaderButtonStyle}"
                        Command="{Binding ToggleCommand}"
                        AutomationProperties.Name="{Binding AutomationName}"
                        AutomationProperties.HelpText="{Binding AutomationHelpText}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource TodayGroupTitleTextStyle}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Style="{StaticResource TodayGroupSubtitleTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ItemCountText}"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource ContentSecondaryBrush}"
                                   Margin="8,0,10,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ExpandGlyph}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                </Button>

                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TodayTaskItemTemplate}"
                              today:TodayTaskDragDropBehavior.IsEnabled="True"
                              Visibility="{Binding IsExpanded, Converter={StaticResource TodayBooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TodaySelectedTaskTemplate">
        <Border Style="{StaticResource TodayPanelStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static local:UiText.TodayDetails}"
                               Style="{StaticResource TodayEyebrowTextStyle}" />
                    <Border Grid.Column="1"
                            Style="{StaticResource TodayChipBorderStyle}">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource CardTitleTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
                <TextBlock Text="{Binding TimeLabel}"
                           Style="{StaticResource TodayMetricValueTextStyle}"
                           Margin="0,14,0,0" />
                <TextBlock Text="{Binding StatusDescription}"
                           Style="{StaticResource TodayTaskMetaTextStyle}"
                           TextWrapping="Wrap" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static local:UiText.TodayTimeShape}"
                                   Style="{StaticResource TodayEyebrowTextStyle}" />
                        <TextBlock Text="{Binding TimeShapeLabel}"
                                   Style="{StaticResource TodayMetricLabelTextStyle}"
                                   Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static local:UiText.TodayPriority}"
                                   Style="{StaticResource TodayEyebrowTextStyle}" />
                        <TextBlock Text="{Binding PriorityLabel}"
                                   Style="{StaticResource TodayMetricLabelTextStyle}"
                                   Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,18,0,0"
                        Padding="12"
                        Background="{DynamicResource ShellBackgroundBrush}"
                        CornerRadius="8"
                        Visibility="{Binding IsNeedsReviewVisible, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Static local:UiText.TodayRangeNeedsResult}"
                               FontSize="12"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding Notes}"
                           Style="{StaticResource CardBodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,20,0,0">
                    <Button Content="{Binding CompletionActionLabel}"
                            Command="{Binding ToggleCompletionCommand}"
                            Style="{StaticResource TodayButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsCompletionActionEnabled}"
                            AutomationProperties.Name="{Binding CompletionActionLabel}" />
                    <Button Content="{Binding PinActionLabel}"
                            Command="{Binding TogglePinCommand}"
                            Style="{StaticResource TodaySecondaryButtonStyle}"
                            AutomationProperties.Name="{Binding PinActionLabel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsPlanActionsVisible, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                    <Button Content="{Binding RescheduleActionLabel}"
                            Command="{Binding RescheduleCommand}"
                            Style="{StaticResource TodaySecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding RescheduleActionLabel}"
                            AutomationProperties.HelpText="修改计划的日期或时间，已有结果的 Task 不能改期" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsNeedsReviewVisible, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                    <Button Content="{Binding RecordPartialActionLabel}"
                            Command="{Binding RecordPartialCommand}"
                            Style="{StaticResource TodaySecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding RecordPartialActionLabel}"
                            AutomationProperties.HelpText="为已结束的 RANGE Task 记录部分完成结果" />
                    <Button Content="{Binding RecordMissedActionLabel}"
                            Command="{Binding RecordMissedCommand}"
                            Style="{StaticResource TodaySecondaryButtonStyle}"
                            AutomationProperties.Name="{Binding RecordMissedActionLabel}"
                            AutomationProperties.HelpText="为已结束的 RANGE Task 记录未完成结果" />
                </StackPanel>

                <Button Content="{Binding ContinueActionLabel}"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource TodaySecondaryButtonStyle}"
                        Margin="0,10,0,0"
                        Visibility="{Binding CanContinue, Converter={StaticResource TodayBooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding ContinueActionLabel}"
                        AutomationProperties.HelpText="从 PARTIAL 结果创建新的继续 Task" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type today:TodayPageViewModel}">
        <Grid Margin="{StaticResource PageContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static local:UiText.WidgetTodayTab}"
                                   Style="{StaticResource TodayEyebrowTextStyle}" />
                        <TextBlock Text="{x:Static local:UiText.ShellTodayTitle}"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DateSummary}"
                                   Style="{StaticResource TodayDateTextStyle}" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource TodayIntroTextStyle}"
                                   MaxWidth="560" />
                        <TextBlock Text="{Binding InteractionMessage}"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ContentSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Border Style="{StaticResource TodayChipBorderStyle}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMock, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding MockBadge}"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Button Content="刷新 TODAY"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource TodaySecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="刷新 TODAY"
                                AutomationProperties.HelpText="重新读取本地 Task 查询结果" />
                        <Button Content="{x:Static local:UiText.TodayQuickAdd}"
                                Command="{Binding OpenQuickAddCommand}"
                                Style="{StaticResource TodayButtonStyle}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="{x:Static local:UiText.TodayQuickAdd}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource TodayPanelStyle}"
                        Visibility="{Binding IsQuickAddOpen, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock Text="{x:Static local:UiText.TodayQuickAdd}"
                                       Style="{StaticResource TodayEyebrowTextStyle}" />
                            <TextBlock Text="{Binding QuickAddDescription}"
                                       Style="{StaticResource TodayTaskMetaTextStyle}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0"
                                    Padding="10,7"
                                    Background="#EEF0FF"
                                    BorderBrush="#D7DCFF"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock Text="{Binding InteractionMessage}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>
                        <TextBox Grid.Row="1"
                                 Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TodayTextBoxStyle}"
                                 Margin="0,14,10,0"
                                 ToolTip="{x:Static local:UiText.TodayQuickAddToolTip}"
                                 AutomationProperties.Name="{x:Static local:UiText.TodayQuickAddToolTip}"
                                 AutomationProperties.HelpText="{x:Static local:UiText.TodayQuickAddToolTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding AddQuickTaskCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="0,14,0,0">
                            <Button Content="{x:Static local:UiText.TodayAddToToday}"
                                    Command="{Binding AddQuickTaskCommand}"
                                    Style="{StaticResource TodayButtonStyle}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="{x:Static local:UiText.TodayAddToToday}" />
                            <Button Content="{x:Static local:UiText.CommonCancel}"
                                    Command="{Binding CancelQuickAddCommand}"
                                    Style="{StaticResource TodaySecondaryButtonStyle}"
                                    AutomationProperties.Name="{x:Static local:UiText.CommonCancel}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource TodayPanelStyle}"
                        Visibility="{Binding IsRescheduleOpen, Converter={StaticResource TodayBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="改期计划"
                                       Style="{StaticResource TodayEyebrowTextStyle}" />
                            <TextBlock Text="{Binding RescheduleTaskTitle}"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="日期支持今天、明天、后天、yyyy-MM-dd；时间支持 HH:mm 或 HH:mm-HH:mm，留空表示 ANYTIME。旧计划会保留在历史中。"
                                       Style="{StaticResource TodayTaskMetaTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <TextBox Text="{Binding RescheduleDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TodayTextBoxStyle}"
                                     Width="160"
                                     Margin="0,0,10,0"
                                     ToolTip="改期日期"
                                     AutomationProperties.Name="改期日期"
                                     AutomationProperties.HelpText="输入今天、明天、后天或 yyyy-MM-dd" />
                            <TextBox Text="{Binding RescheduleTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TodayTextBoxStyle}"
                                     Width="160"
                                     ToolTip="改期时间"
                                     AutomationProperties.Name="改期时间"
                                     AutomationProperties.HelpText="输入 HH:mm 或 HH:mm-HH:mm，留空表示 ANYTIME" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Content="确认改期"
                                    Command="{Binding ConfirmRescheduleCommand}"
                                    Style="{StaticResource TodayButtonStyle}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="确认改期"
                                    AutomationProperties.HelpText="保存新计划并刷新 TODAY" />
                            <Button Content="{x:Static local:UiText.CommonCancel}"
                                    Command="{Binding CancelRescheduleCommand}"
                                    Style="{StaticResource TodaySecondaryButtonStyle}"
                                    AutomationProperties.Name="{x:Static local:UiText.CommonCancel}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource TodayPrimaryPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static local:UiText.TodayPrimaryFocus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarPrimaryBrush}" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding PrimaryTask.Title}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,13,0,0" />
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="0,14,0,0">
                                <TextBlock Text="{Binding PrimaryTask.TimeLabel}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SidebarPrimaryBrush}" />
                                <TextBlock Text=" · "
                                           FontSize="14"
                                           Foreground="{DynamicResource SidebarSecondaryBrush}" />
                                <TextBlock Text="{Binding PrimaryTask.StatusLabel}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SidebarSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Margin="0,22,0,0">
                                <Button Content="{Binding PrimaryTask.CompletionActionLabel}"
                                        Command="{Binding PrimaryTask.ToggleCompletionCommand}"
                                        Style="{StaticResource TodayHeroLightButtonStyle}"
                                        Margin="0,0,8,0"
                                        IsEnabled="{Binding PrimaryTask.IsCompletionActionEnabled}"
                                        AutomationProperties.Name="{Binding PrimaryTask.CompletionActionLabel}" />
                                <Button Content="{x:Static local:UiText.CommonViewDetails}"
                                        Command="{Binding PrimaryTask.SelectCommand}"
                                        Style="{StaticResource TodayHeroOutlineButtonStyle}"
                                        AutomationProperties.Name="{x:Static local:UiText.CommonViewDetails}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource TodayPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:UiText.TodayReviewQueue}"
                                       Style="{StaticResource TodayEyebrowTextStyle}" />
                            <TextBlock Text="{Binding NeedsReviewText}"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="{Binding NeedsReviewDescription}"
                                       Style="{StaticResource CardBodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{DynamicResource ShellBackgroundBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:UiText.TodayPlanMetric}"
                                               Style="{StaticResource TodayEyebrowTextStyle}" />
                                    <TextBlock Text="{Binding PlanSummary}"
                                               Style="{StaticResource TodayMetricValueTextStyle}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{x:Static local:UiText.TodayViewNeedsReview}"
                                    Command="{Binding OpenNeedsReviewCommand}"
                                    Style="{StaticResource TodaySecondaryButtonStyle}"
                                    Margin="0,16,0,0"
                                    AutomationProperties.Name="{x:Static local:UiText.TodayViewNeedsReview}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static local:UiText.TodayPlan}"
                                       Style="{StaticResource TodayEyebrowTextStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PlanSummary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ContentSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="点击任务卡查看详情；拖动左侧手柄调整同一日期、同一分组内的顺序"
                                   Style="{StaticResource TodayTaskMetaTextStyle}"
                                   Margin="0,-5,0,12" />
                        <ItemsControl ItemsSource="{Binding Groups}"
                                      ItemTemplate="{StaticResource TodayTaskGroupTemplate}" />
                    </StackPanel>
                </Grid>

                    </Grid>
                </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
