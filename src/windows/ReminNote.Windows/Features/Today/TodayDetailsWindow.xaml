<Window x:Class="ReminNote.Windows.Features.Today.TodayDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TODAY 任务详情"
        AutomationProperties.Name="TODAY 任务详情"
        Width="620"
        Height="620"
        MinWidth="500"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">
    <Border Margin="12"
            Padding="20"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="0,0,0,16">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Content="×"
                        Click="OnCloseClick"
                        Style="{StaticResource TodaySecondaryButtonStyle}"
                        Padding="10,5"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭 TODAY 任务详情" />
                <StackPanel>
                    <TextBlock Text="TODAY DETAILS"
                               Style="{StaticResource TodayEyebrowTextStyle}" />
                    <TextBlock Text="任务详情与操作"
                               Margin="0,3,0,0"
                               Style="{StaticResource TodayGroupTitleTextStyle}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ContentControl Content="{Binding SelectedTask}"
                                ContentTemplate="{StaticResource TodaySelectedTaskTemplate}" />
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="拖动任务卡左侧手柄可调整同组顺序"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ContentSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,12,0" />
                <Button Content="关闭"
                        Click="OnCloseClick"
                        Style="{StaticResource TodaySecondaryButtonStyle}"
                        AutomationProperties.Name="关闭 TODAY 任务详情" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
