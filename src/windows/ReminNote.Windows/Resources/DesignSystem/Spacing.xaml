<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared layout tokens keep shell and future Widget spacing coherent. -->
    <Thickness x:Key="PageContentMargin">36,30,36,30</Thickness>
    <Thickness x:Key="PageDescriptionMargin">0,10,0,28</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="CardBodyMargin">0,8,0,0</Thickness>
    <Thickness x:Key="HeaderPadding">36,28,36,20</Thickness>
    <Thickness x:Key="FooterPadding">36,10</Thickness>
    <Thickness x:Key="SidebarBrandMargin">24,28,24,22</Thickness>
    <Thickness x:Key="SidebarFooterMargin">24,20</Thickness>
    <Thickness x:Key="NavigationItemsMargin">12,0</Thickness>
    <Thickness x:Key="NavigationButtonPadding">16,12</Thickness>
    <Thickness x:Key="NavigationButtonMargin">0,4</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="NavigationCornerRadius">8</CornerRadius>
</ResourceDictionary>
