<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bright, clean palette from the product UI direction. -->
    <Color x:Key="ShellBackgroundColor">#F4F6FA</Color>
    <Color x:Key="SidebarBackgroundColor">#182333</Color>
    <Color x:Key="SidebarPrimaryColor">#FFFFFF</Color>
    <Color x:Key="SidebarSecondaryColor">#AEB9C9</Color>
    <Color x:Key="SidebarHoverColor">#2A3850</Color>
    <Color x:Key="SidebarPressedColor">#354765</Color>
    <Color x:Key="SidebarFocusColor">#8FA8FF</Color>
    <Color x:Key="AccentColor">#5B6EF5</Color>
    <Color x:Key="AccentHoverColor">#4E60E0</Color>
    <Color x:Key="AccentPressedColor">#4353C4</Color>
    <Color x:Key="ContentPrimaryColor">#172033</Color>
    <Color x:Key="ContentSecondaryColor">#667085</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E9F0</Color>
    <Color x:Key="FocusColor">#5B6EF5</Color>
    <Color x:Key="DisabledColor">#98A2B3</Color>

    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{DynamicResource ShellBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryBrush" Color="{DynamicResource SidebarPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarSecondaryBrush" Color="{DynamicResource SidebarSecondaryColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="{DynamicResource SidebarPressedColor}" />
    <SolidColorBrush x:Key="SidebarFocusBrush" Color="{DynamicResource SidebarFocusColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ContentPrimaryBrush" Color="{DynamicResource ContentPrimaryColor}" />
    <SolidColorBrush x:Key="ContentSecondaryBrush" Color="{DynamicResource ContentSecondaryColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource FocusColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}" />
</ResourceDictionary>
