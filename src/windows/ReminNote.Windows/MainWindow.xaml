<Window x:Class="ReminNote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReminNote.Windows.ViewModels"
        Title="ReminNote"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource ShellBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayPageViewModel}">
            <Grid Margin="{StaticResource PageContentMargin}">
                <StackPanel MaxWidth="720">
                    <TextBlock Text="今天"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="P0-02 Shell 占位"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="TODAY 的真实任务、分组和状态会在后续 Slice 接入。"
                                       Style="{StaticResource CardBodyTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AnimePageViewModel}">
            <Grid Margin="{StaticResource PageContentMargin}">
                <StackPanel MaxWidth="720">
                    <TextBlock Text="动画"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="ANIME Shell 占位"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="动画数据、追番状态和网络 Provider 会在后续 Slice 接入。"
                                       Style="{StaticResource CardBodyTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Style="{StaticResource SidebarSurfaceStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Margin="{StaticResource SidebarBrandMargin}">
                    <TextBlock Text="ReminNote"
                               Style="{StaticResource BrandTitleTextStyle}" />
                    <TextBlock Text="个人提醒与记录"
                               Margin="0,6,0,0"
                               Style="{StaticResource SidebarSubtitleTextStyle}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="{StaticResource SidebarFooterMargin}"
                           Text="P0-03 · Design System"
                           Style="{StaticResource SidebarFooterTextStyle}" />

                <ItemsControl ItemsSource="{Binding NavigationItems}"
                              Margin="{StaticResource NavigationItemsMargin}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource SidebarNavigationTitleTextStyle}" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource SidebarNavigationSubtitleTextStyle}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="0"
                Style="{StaticResource HeaderSurfaceStyle}">
            <StackPanel>
                <TextBlock Text="{Binding ActiveTitle}"
                           Style="{StaticResource ShellHeaderTitleTextStyle}" />
                <TextBlock Text="本地优先 · 当前为 P0-03 设计系统壳"
                           Style="{StaticResource ShellHeaderSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Grid.Row="1"
                        Content="{Binding CurrentPage}" />

        <Border Grid.Column="1"
                Grid.Row="2"
                Style="{StaticResource FooterSurfaceStyle}">
            <TextBlock Text="基础壳已启动 · 设计系统已加载 · 业务数据尚未接入"
                       Style="{StaticResource FooterTextStyle}" />
        </Border>
    </Grid>
</Window>
