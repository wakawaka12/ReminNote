<Application x:Class="ReminNote.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignSystem/Colors.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Spacing.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Typography.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.xaml" />
                <ResourceDictionary Source="Features/Today/TodayResources.xaml" />
                <ResourceDictionary Source="Features/Reminders/ReminderResources.xaml" />
                <ResourceDictionary Source="Features/Anime/AnimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
